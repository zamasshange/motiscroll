# Copy to functions/.env.local for the emulator, or set these in Secret Manager.
# Never commit real values. The Flutter app must not contain these.

# Contact address sent in the User-Agent on Wikiquote, Wikimedia, and feed requests.
CONTACT_EMAIL=editor@example.com

# Used only by Cloud Functions (draftDeeper, field/mood suggestions).
LLM_API_KEY=

# YouTube Data API key for official-channel metadata. Never a transcript download.
YOUTUBE_API_KEY=
