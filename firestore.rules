rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isEditor() {
      return signedIn() && request.auth.token.editor == true;
    }
    function lockedKeys() {
      return ['streakCount', 'lastActiveDate', 'reminderUtcBucket', 'lastPushDate'];
    }
    function hhmm(value) {
      return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }
    function quoteSource(value) {
      return value in ['followed_fields', 'all', 'mood'];
    }
    function notificationFieldsOk() {
      return (!('morningEnabled' in request.resource.data) || request.resource.data.morningEnabled is bool)
        && (!('morningTime' in request.resource.data) || hhmm(request.resource.data.morningTime))
        && (!('eveningEnabled' in request.resource.data) || request.resource.data.eveningEnabled is bool)
        && (!('eveningTime' in request.resource.data) || hhmm(request.resource.data.eveningTime))
        && (!('pausedUntil' in request.resource.data) || request.resource.data.pausedUntil == null || request.resource.data.pausedUntil is string)
        && (!('quoteSource' in request.resource.data) || quoteSource(request.resource.data.quoteSource))
        && (!('timezone' in request.resource.data) || request.resource.data.timezone is string);
    }

    match /publishedItems/{itemId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /publishedAuthors/{authorId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /collections/{fieldSlug} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /daily/{day} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(lockedKeys())
        && notificationFieldsOk()
        && request.resource.data.size() < 40;
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(lockedKeys())
        && notificationFieldsOk();
      allow delete: if false;

      match /saved/{itemId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && request.resource.data.size() < 12;
      }
      match /liked/{itemId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && request.resource.data.size() < 12;
      }
      match /followedFields/{field} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && request.resource.data.size() < 8;
      }
      match /progress/{itemId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && request.resource.data.size() < 12;
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly(['itemId', 'userId', 'reason', 'note', 'status', 'createdAt'])
        && request.resource.data.note is string
        && request.resource.data.note.size() < 500;
      allow read, update: if isEditor();
      allow delete: if false;
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly(['userId', 'topic', 'message', 'status', 'createdAt'])
        && request.resource.data.topic is string
        && request.resource.data.topic.size() < 80
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() < 2000;
      allow read, update: if isEditor();
      allow delete: if false;
    }

    match /items/{itemId} {
      allow read, write: if isEditor();
      match /{subcollection}/{docId} {
        allow read, write: if isEditor();
      }
    }
    match /authors/{authorId} {
      allow read, write: if isEditor();
    }
    match /misattributionWatchlist/{authorId} {
      allow read, write: if isEditor();
    }
    match /importSources/{sourceId} {
      allow read, write: if isEditor();
    }
    match /importLog/{logId} {
      allow read, write: if isEditor();
    }
    match /config/{docId} {
      allow read, write: if isEditor();
    }
  }
}
