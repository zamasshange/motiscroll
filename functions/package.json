{
  "name": "moti-scroll-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only auth,functions,firestore,storage",
    "seed": "npm run build && node lib/seed.js",
    "grant-editor": "node scripts/grant-editor.mjs",
    "test": "npm run build && node --test test/gate.test.mjs",
    "test:rules": "firebase emulators:exec --config ../firebase.json --only firestore \"node test/rules.test.mjs\""
  },
  "dependencies": {
    "firebase-admin": "^13.5.0",
    "firebase-functions": "^6.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^13.1.0",
    "typescript": "^5.9.2"
  }
}
